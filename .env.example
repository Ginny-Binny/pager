# Copy to .env and fill in. docker-compose.yml reads this file.
# Do not commit .env — NTFY_TOKEN is a credential.

# ── Domains ───────────────────────────────────────────────────────────────
# Both must have DNS A/AAAA records pointing at this host before first start,
# or Caddy cannot obtain certificates.
NTFY_DOMAIN=ntfy.example.com
PAGER_DOMAIN=pager.example.com
ACME_EMAIL=you@example.com

# Public URL of the ntfy server, used by ntfy itself for link generation.
NTFY_PUBLIC_URL=https://ntfy.example.com

# Public URL of this monitor. Ack links in your notifications are built from
# it, so it must be reachable from your phone on mobile data.
PUBLIC_BASE_URL=https://pager.example.com

# ── ntfy ──────────────────────────────────────────────────────────────────
# Topic name. Treat it as private even though access control is enforced by
# auth-default-access: deny-all.
NTFY_TOPIC=alerts

# Access token for the pager user. Create it after first start:
#   docker compose exec ntfy ntfy user add --role=user pager
#   docker compose exec ntfy ntfy access pager alerts rw
#   docker compose exec ntfy ntfy token add pager
NTFY_TOKEN=tk_replace_me

# ── /status basic auth ────────────────────────────────────────────────────
# bcrypt hash for the "admin" user, from:
#   docker run --rm caddy:2-alpine caddy hash-password
#
# IMPORTANT: double every $ in the hash. Compose interpolates $ in this file,
# so a pasted bcrypt hash ($2a$14$...) is silently mangled and the resulting
# password never matches — you get a 401 with no error anywhere explaining it.
# A hash of  $2a$14$abc...  must be written as  $$2a$$14$$abc...
STATUS_BASIC_AUTH=$$2a$$14$$replace_me

# ── Tuning (optional; these are the defaults) ─────────────────────────────
# POLL_INTERVAL=60s
# ESCALATION_INTERVAL=5m
# FAILURE_THRESHOLD=3
# RECOVERY_THRESHOLD=2
# LOG_LEVEL=info
