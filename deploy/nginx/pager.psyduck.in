# pager.psyduck.in — reverse proxy for the pager monitor.
#
# This host already runs nginx on 80/443, so the caddy service in
# docker-compose.yml is removed and this block replaces the Caddyfile's
# {$PAGER_DOMAIN} site. The pager container publishes on 127.0.0.1:8080 only.
#
# The three routes below mirror the Caddyfile exactly and the auth split is
# not optional:
#   /health  open — an external heartbeat must reach it without credentials.
#   /ack/*   open — the ack link must work from a phone the instant a page
#            arrives; the random per-incident token in the URL is what
#            authorises it, not a password prompt at 3am.
#   /status  behind basic auth — it lists every internal check name and URL.
# Everything else is a 404.

server {
    server_name pager.psyduck.in;

    # Matches the Caddyfile's header block.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Open: external heartbeat. Only ever discloses a timestamp.
    location = /health {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    # Open: the ack link from the notification. Note the prefix match — the
    # check name is a path segment (/ack/connect-app).
    location /ack/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    # Guarded: lists every check name and URL.
    location = /status {
        auth_basic           "pager";
        auth_basic_user_file /etc/nginx/.htpasswd-pager;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }

    location / {
        return 404;
    }
}
